# ODsay API (지하철 경로/소요 시간)
# 발급: https://lab.odsay.com/
ODSAY_API_KEY=your_odsay_api_key_here

# Google Places API (주변 장소 추천)
# 발급: https://console.cloud.google.com/ → Places API 활성화
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Next.js Public (클라이언트에서 사용할 키는 NEXT_PUBLIC_ 접두사 필요)
# 주의: NEXT_PUBLIC_ 변수는 브라우저에 노출됩니다
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
